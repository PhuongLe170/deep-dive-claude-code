{
  "permissions": {
    "deny": [
      "Read(./app/api/**/appsettings*.json)",
      "Edit(./app/api/**/appsettings*.json)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./app/api/Api/Migrations/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git reset --*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-git.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-xml-doc.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-stage.sh\""
          }
        ]
      }
    ]
  }
}